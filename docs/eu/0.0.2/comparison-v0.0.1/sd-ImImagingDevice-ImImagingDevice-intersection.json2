      "isSummary" : true,
      "mapping" : [{
        "identity" : "rim",
        "map" : "Role.id.extension"
      },
      {
        "identity" : "udi",
        "map" : "A unique device identifier (UDI) on a device label a form that uses automatic identification and data capture (AIDC) technology."
      }]
    },
    {
      "path" : "Device.udiCarrier.carrierHRF",
